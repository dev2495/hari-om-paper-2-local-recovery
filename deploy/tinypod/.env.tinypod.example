# Copy these values into TinyPod environment variables.
# Do not commit real secrets or client production data.

DB_USER=hariom
DB_PASSWORD=replace-with-a-long-random-db-password
JWT_SECRET=replace-with-a-long-random-jwt-secret

BOOTSTRAP_ADMIN_EMAIL=devarsh@hariom.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
BOOTSTRAP_ADMIN_NAME=Devarsh Admin
BOOTSTRAP_ADMIN_PLANT_ID=PLANT_A

BOOTSTRAP_OWNER_EMAIL=yash@hariom.com
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-owner-password
BOOTSTRAP_OWNER_NAME=Yash Owner
BOOTSTRAP_OWNER_PLANT_ID=PLANT_A

# Set true on temporary staging if you intentionally want startup to reset
# the two bootstrap-user passwords to the environment values above.
RESET_BOOTSTRAP_PASSWORDS=false

# Keep false on a public staging URL unless you intentionally want demo users.
SEED_DEMO_USERS=false

WEB_UI_PORT=13000
ANALYTICS_CACHE_TTL_SECONDS=120
